# Discord Developer Portal credentials
DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_GUILD_ID=YOUR_TEST_SERVER_ID
DISCORD_CHANNEL_ID=YOUR_NEWS_CHANNEL_ID

# Daily security event radar
EVENTS_ENABLED=true
EVENT_CHANNEL_ID=1536696484286824519
EVENT_SCAN_HOUR=9
EVENT_TIME_ZONE=Asia/Taipei
EVENT_LOOKAHEAD_DAYS=120
MAX_EVENTS_PER_RUN=5
EVENT_POLL_INTERVAL_MINUTES=30

# Polling and delivery
POLL_INTERVAL_MINUTES=30
LOOKBACK_HOURS=48
MAX_ARTICLES_PER_RUN=5
PUSH_ON_START=true
PUBLISH_INITIAL_ARTICLES=true

# OpenAI-compatible AI endpoint (provider-neutral; all three values are required)
AI_FILTER_ENABLED=true
MAX_AI_EVALUATIONS_PER_RUN=10
AI_MAX_OUTPUT_TOKENS=800
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional persistent state store (recommended for cloud containers)
DATABASE_URL=

# News source (The Hacker News Blogger JSON Feed by default)
NEWS_FEED_URL=https://thehackernews.com/feeds/posts/default?alt=json&redirect=false&max-results=50
NEWS_SOURCE_NAME=The Hacker News

# Structured security event sources
CTFTIME_EVENTS_URL=https://ctftime.org/api/v1/events/
OWASP_EVENTS_URL=https://raw.githubusercontent.com/OWASP/owasp.github.io/main/_data/events.yml
TAIWAN_DEADLINES_ENABLED=true
TAIWAN_DEADLINES_URL=https://raw.githubusercontent.com/stwater20/taiwan-security-deadlines/main/_data/conferences.yml
